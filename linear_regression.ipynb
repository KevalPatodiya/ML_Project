    "import numpy as np\n",
    "import pandas as pd\n",
    "from IPython.display import display\n",
    "\n",
    "\n",
    "def within_10_pct(actual, predicted):\n",
    "    actual = np.asarray(actual)\n",
    "    predicted = np.asarray(predicted)\n",
    "    positive = actual > 0\n",
    "\n",
    "    if not positive.any():\n",
    "        return np.nan\n",
    "\n",
    "    error = np.abs(actual[positive] - predicted[positive])\n",
    "    return 100 * np.mean(error <= 0.10 * actual[positive])\n",
    "\n",
    "\n",
    "train_base = saved_ridge.predict(X_train)\n",
    "train_pounds = train_base + residual_model.predict(X_train)\n",
    "\n",
    "train_proportional = np.expm1(\n",
    "    np.log1p(np.maximum(train_base, 0.0))\n",
    "    + relative_booster.predict(X_train)\n",
    ")\n",
    "\n",
    "rows = []\n",
    "for name, train_pred, val_pred in [\n",
    "    (\"Saved log-price Ridge\", train_base, base_prediction),\n",
    "    (\"Ridge + correction in pounds\", train_pounds, corrected_prediction),\n",
    "    (\"Ridge + proportional correction\", train_proportional, relative_prediction),\n",
    "]:\n",
    "    train_rate = within_10_pct(y_train, train_pred)\n",
    "    val_rate = within_10_pct(y_val, val_pred)\n",
    "\n",
    "    rows.append({\n",
    "        \"Model\": name,\n",
    "        \"Training within 10% (%)\": train_rate,\n",
    "        \"Validation within 10% (%)\": val_rate,\n",
    "        \"Train − validation gap (pp)\": train_rate - val_rate,\n",
    "    })\n",
    "\n",
    "display(pd.DataFrame(rows).set_index(\"Model\").round(3))"
   ]
  },
