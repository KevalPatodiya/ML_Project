   "source": [
    "from pathlib import Path\n",
    "\n",
    "import joblib\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from IPython.display import display\n",
    "from sklearn.metrics import (\n",
    "    accuracy_score,\n",
    "    mean_absolute_error,\n",
    "    mean_absolute_percentage_error,\n",
    "    mean_squared_error,\n",
    "    median_absolute_error,\n",
    "    r2_score,\n",
    ")\n",
    "\n",
    "TEST_PATH = Path(\n",
    "    r\"D:\\Msc DS\\Machine Learning\\Project\\Sample Project\\test.csv\"\n",
    ")\n",
    "MODEL_PATH = Path(\"used_car_ridge_gradient_boosting.joblib\")\n",
    "\n",
    "for path in (TEST_PATH, MODEL_PATH):\n",
    "    if not path.is_file():\n",
    "        raise FileNotFoundError(f\"File not found: {path.resolve()}\")\n",
    "\n",
    "bundle = joblib.load(MODEL_PATH)\n",
    "test_raw = pd.read_csv(TEST_PATH)\n",
    "\n",
    "# Apply the same listing filters used to train the saved models.\n",
    "eligible = (\n",
    "    test_raw[\"condition\"].eq(\"Used\")\n",
    "    & test_raw[\"reg_year\"].notna()\n",
    "    & (\n",
    "        test_raw[\"previous_owners\"].isna()\n",
    "        | test_raw[\"previous_owners\"].lt(8)\n",
    "    )\n",
    ")\n",
    "test = test_raw.loc[eligible & test_raw[\"price_gbp\"].notna()].copy()\n",
    "\n",
    "if test.empty:\n",
    "    raise ValueError(\"No eligible test listings have a recorded asking price.\")\n",
    "\n",
    "# Apply the same fixed cleaning rules and feature engineering.\n",
    "co2 = (test[\"co2_gkm\"] * 1.609344).round()\n",
    "test[\"co2_gmile\"] = co2.mask(co2.isin([1608, 2092]))\n",
    "test[\"power_hp\"] = test[\"power_hp\"].mask(test[\"power_hp\"].le(0))\n",
    "\n",
    "for col in [\"doors\", \"seats\"]:\n",
    "    test[col] = test[col].mask(test[col].lt(2))\n",
    "\n",
    "categorical_cols = [\n",
    "    \"make\", \"model\", \"version\", \"fuel\", \"transmission\", \"body_type\",\n",
    "    \"body_color\", \"drivetrain\", \"emission_class\", \"seller_type\",\n",
    "    \"seller_city\", \"seller_county\",\n",
    "]\n",
    "\n",
    "for col in categorical_cols:\n",
    "    test[col] = (\n",
    "        test[col].str.strip()\n",
    "        .replace({\"\": \"Unknown\", \"Unlisted\": \"Unknown\"})\n",
    "        .fillna(\"Unknown\")\n",
    "    )\n",
    "\n",
    "test[\"log_mileage\"] = np.log1p(test[\"mileage_miles\"])\n",
    "test[\"make_model\"] = test[\"make\"] + \" | \" + test[\"model\"]\n",
    "\n",
    "# Select the exact input columns expected by the saved bundle.\n",
    "X_test = test.loc[:, bundle[\"feature_columns\"]]\n",
    "actual = test[\"price_gbp\"].to_numpy()\n",
    "\n",
    "ridge_prediction = bundle[\"base_model\"].predict(X_test)\n",
    "correction = bundle[\"correction_model\"].predict(X_test)\n",
    "ensemble_prediction = (\n",
    "    ridge_prediction + bundle[\"correction_weight\"] * correction\n",
    ")\n",
    "\n",
    "positive = actual > 0\n",
    "cutoffs = [10_000, 25_000]\n",
    "actual_bands = np.digitize(actual, cutoffs)\n",
    "rows = []\n",
    "\n",
    "for name, predicted in [\n",
    "    (\"Log-price Ridge\", ridge_prediction),\n",
    "    (\"Ridge + Gradient Boosting\", ensemble_prediction),\n",
    "]:\n",
    "    residual = actual - predicted\n",
    "\n",
    "    rows.append({\n",
    "        \"Model\": name,\n",
    "        \"MAE (£)\": mean_absolute_error(actual, predicted),\n",
    "        \"RMSE (£)\": np.sqrt(mean_squared_error(actual, predicted)),\n",
    "        \"Median absolute error (£)\": median_absolute_error(actual, predicted),\n",
    "        \"MAPE (%)\": (\n",
    "            100 * mean_absolute_percentage_error(\n",
    "                actual[positive], predicted[positive]\n",
    "            ) if positive.any() else np.nan\n",
    "        ),\n",
    "        \"R²\": r2_score(actual, predicted),\n",
    "        \"Within 10% (%)\": (\n",
    "            100 * np.mean(\n",
    "                np.abs(residual[positive]) <= 0.10 * actual[positive]\n",
    "            ) if positive.any() else np.nan\n",
    "        ),\n",
    "        \"Band accuracy (%)\": 100 * accuracy_score(\n",
    "            actual_bands, np.digitize(predicted, cutoffs)\n",
    "        ),\n",
    "        \"Mean residual (£)\": residual.mean(),\n",
    "    })\n",
    "\n",
    "comparison = pd.DataFrame(rows).set_index(\"Model\")\n",
    "print(f\"Evaluated {len(test):,} of {len(test_raw):,} test listings.\")\n",
    "display(comparison.round(3))\n",
    "\n",
    "mae_gain = rows[0][\"MAE (£)\"] - rows[1][\"MAE (£)\"]\n",
    "print(f\"Test MAE improvement from the correction: £{mae_gain:+,.2f}\")\n",
    "\n",
    "prediction_details = pd.DataFrame({\n",
    "    \"Actual (£)\": actual,\n",
    "    \"Ridge prediction (£)\": ridge_prediction,\n",
    "    \"Applied correction (£)\": bundle[\"correction_weight\"] * correction,\n",
    "    \"Final prediction (£)\": ensemble_prediction,\n",
    "    \"Final residual (£)\": actual - ensemble_prediction,\n",
    "}, index=test.index)\n",
    "\n",
    "display(prediction_details.head(15).round(2))"
   ]
  },
