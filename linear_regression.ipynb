    "import numpy as np\n",
    "import pandas as pd\n",
    "from IPython.display import display\n",
    "\n",
    "actual = y_val.to_numpy()\n",
    "positive = actual > 0\n",
    "\n",
    "actual = actual[positive]\n",
    "ridge = np.asarray(base_prediction)[positive]\n",
    "correction = np.asarray(predicted_correction)[positive]\n",
    "\n",
    "current_hits = np.abs(actual - (ridge + correction)) <= 0.10 * actual\n",
    "rows = []\n",
    "\n",
    "for weight in [0.0, 0.25, 0.50, 0.75, 1.0, 1.25, 1.50]:\n",
    "    predicted = ridge + weight * correction\n",
    "    abs_error = np.abs(actual - predicted)\n",
    "    hits = abs_error <= 0.10 * actual\n",
    "\n",
    "    rows.append({\n",
    "        \"Correction weight\": weight,\n",
    "        \"Within 10% (%)\": 100 * hits.mean(),\n",
    "        \"Change vs current (pp)\": 100 * (hits.mean() - current_hits.mean()),\n",
    "        \"Listings gained\": np.count_nonzero(hits & ~current_hits),\n",
    "        \"Listings lost\": np.count_nonzero(current_hits & ~hits),\n",
    "        \"MAE (£)\": abs_error.mean(),\n",
    "        \"MAPE (%)\": 100 * (abs_error / actual).mean(),\n",
    "        \"RMSE (£)\": np.sqrt(np.mean(abs_error ** 2)),\n",
    "    })\n",
    "\n",
    "weight_results = pd.DataFrame(rows).sort_values(\n",
    "    [\"Within 10% (%)\", \"MAE (£)\"], ascending=[False, True]\n",
    ")\n",
    "display(weight_results.round(3))"
   ]
