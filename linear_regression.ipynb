    "from sklearn.model_selection import GridSearchCV, KFold\n",
    "from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "param_grid = {\n",
    "    \"preprocessor__numeric_poly__polynomial__degree\": [1, 2],\n",
    "    \"model__alpha\": [0.1, 1, 10, 100, 1000]\n",
    "}\n",
    "\n",
    "cv = KFold(n_splits=3, shuffle=True, random_state=42)\n",
    "\n",
    "poly_search = GridSearchCV(\n",
    "    estimator=poly_model,\n",
    "    param_grid=param_grid,\n",
    "    scoring=\"neg_mean_absolute_error\",\n",
    "    cv=cv,\n",
    "    n_jobs=2,\n",
    "    pre_dispatch=2,\n",
    "    verbose=1,\n",
    "    refit=True,\n",
    "    error_score=\"raise\"\n",
    ")\n",
    "\n",
    "# Tune on training data only\n",
    "poly_search.fit(X_train, y_train)\n",
    "\n",
    "best_poly_model = poly_search.best_estimator_\n",
    "\n",
    "print(\"Best parameters:\", poly_search.best_params_)\n",
    "print(\"Best CV MAE (£):\", round(-poly_search.best_score_, 2))\n",
    "\n",
    "# Compare training and validation performance\n",
    "results = []\n",
    "\n",
    "for name, X_part, y_part in [\n",
    "    (\"Training\", X_train, y_train),\n",
    "    (\"Validation\", X_val, y_val)\n",
    "]:\n",
    "    predictions = best_poly_model.predict(X_part)\n",
    "\n",
    "    results.append({\n",
    "        \"Dataset\": name,\n",
    "        \"MAE (£)\": mean_absolute_error(y_part, predictions),\n",
    "        \"RMSE (£)\": np.sqrt(mean_squared_error(y_part, predictions)),\n",
    "        \"R²\": r2_score(y_part, predictions)\n",
    "    })\n",
    "\n",
    "display(pd.DataFrame(results).round(3))\n",
    "\n",
    "# Show all parameter combinations, best first\n",
    "tuning_results = pd.DataFrame(poly_search.cv_results_)\n",
    "tuning_results[\"CV MAE (£)\"] = -tuning_results[\"mean_test_score\"]\n",
    "\n",
    "display(\n",
    "    tuning_results[[\n",
    "        \"param_preprocessor__numeric_poly__polynomial__degree\",\n",
    "        \"param_model__alpha\",\n",
    "        \"CV MAE (£)\",\n",
    "        \"rank_test_score\"\n",
    "    ]]\n",
    "    .sort_values(\"rank_test_score\")\n",
    "    .reset_index(drop=True)\n",
    ")"
   ]
