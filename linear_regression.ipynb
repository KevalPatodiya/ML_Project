    "from pathlib import Path\n",
    "\n",
    "import joblib\n",
    "import numpy as np\n",
    "import sklearn\n",
    "\n",
    "from sklearn.metrics import mean_absolute_error\n",
    "from sklearn.utils.validation import check_is_fitted\n",
    "\n",
    "check_is_fitted(saved_ridge)\n",
    "check_is_fitted(residual_model)\n",
    "\n",
    "model_path = Path(\"used_car_ridge_gradient_boosting.joblib\")\n",
    "\n",
    "bundle = {\n",
    "    \"base_model\": saved_ridge,\n",
    "    \"correction_model\": residual_model,  # Fitted Gradient Boosting with Huber loss\n",
    "    \"correction_weight\": 1.0,\n",
    "    \"feature_columns\": list(saved_ridge.feature_names_in_),\n",
    "    \"sklearn_version\": sklearn.__version__,\n",
    "    \"validation_mae_gbp\": float(mean_absolute_error(y_val, corrected_prediction)),\n",
    "}\n",
    "\n",
    "joblib.dump(bundle, model_path, compress=3)\n",
    "\n",
    "# Verify that reloading reproduces the fitted ensemble's predictions.\n",
    "reloaded = joblib.load(model_path)\n",
    "sample = X_val.loc[:, reloaded[\"feature_columns\"]].iloc[:100]\n",
    "\n",
    "reloaded_predictions = (\n",
    "    reloaded[\"base_model\"].predict(sample)\n",
    "    + reloaded[\"correction_weight\"] * reloaded[\"correction_model\"].predict(sample)\n",
    ")\n",
    "\n",
    "np.testing.assert_allclose(reloaded_predictions, corrected_prediction[:len(sample)])\n",
    "\n",
    "print(f\"Saved and verified: {model_path.resolve()}\")\n",
    "print(f\"Validation MAE: £{reloaded['validation_mae_gbp']:,.2f}\")"
   ]
  },
