    "import numpy as np\n",
    "import pandas as pd\n",
    "from IPython.display import display\n",
    "\n",
    "from sklearn.compose import ColumnTransformer\n",
    "from sklearn.impute import SimpleImputer\n",
    "from sklearn.linear_model import LinearRegression\n",
    "from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score\n",
    "from sklearn.model_selection import GroupKFold, GroupShuffleSplit\n",
    "from sklearn.pipeline import Pipeline\n",
    "from sklearn.preprocessing import OneHotEncoder, StandardScaler\n",
    "\n",
    "df = pd.read_csv(\"used_cars_cleaned_08.csv\")\n",
    "\n",
    "# Explicitly select information available before estimating the price.\n",
    "feature_cols = [\n",
    "    \"make\", \"model\", \"version\", \"mileage_miles\", \"reg_year\",\n",
    "    \"fuel\", \"transmission\", \"power_hp\", \"body_type\", \"body_color\",\n",
    "    \"doors\", \"seats\", \"previous_owners\", \"drivetrain\", \"emission_class\",\n",
    "    \"annual_tax_gbp\", \"seller_type\", \"seller_city\", \"seller_county\",\n",
    "    \"co2_gmile\",\n",
    "]\n",
    "\n",
    "X = df.loc[:, feature_cols].copy()\n",
    "y = df[\"price_gbp\"].copy()\n",
    "\n",
    "# Keep identical predictor rows together, even if their prices differ.\n",
    "groups = pd.util.hash_pandas_object(X, index=False)\n",
    "\n",
    "splitter = GroupShuffleSplit(n_splits=1, test_size=0.2, random_state=42)\n",
    "train_idx, val_idx = next(splitter.split(X, y, groups=groups))\n",
    "\n",
    "X_train, X_val = X.iloc[train_idx], X.iloc[val_idx]\n",
    "y_train, y_val = y.iloc[train_idx], y.iloc[val_idx]\n",
    "train_groups = groups.iloc[train_idx]\n",
    "\n",
    "assert not groups.iloc[val_idx].isin(train_groups).any()\n",
    "\n",
    "# Precompute folds for the later searches. These positions refer to X_train.\n",
    "# X_train_text also works with these folds if it preserves the same row order.\n",
    "grouped_cv = list(\n",
    "    GroupKFold(n_splits=3).split(X_train, y_train, groups=train_groups)\n",
    ")\n",
    "cv = grouped_cv\n",
    "\n",
    "numeric_cols = X_train.select_dtypes(include=\"number\").columns.tolist()\n",
    "categorical_cols = X_train.select_dtypes(\n",
    "    include=[\"object\", \"string\", \"category\"]\n",
    ").columns.tolist()\n",
    "\n",
    "numeric_pipeline = Pipeline([\n",
    "    (\"imputer\", SimpleImputer(strategy=\"median\")),\n",
    "    (\"scaler\", StandardScaler()),\n",
    "])\n",
    "\n",
    "categorical_pipeline = Pipeline([\n",
    "    (\"imputer\", SimpleImputer(strategy=\"most_frequent\")),\n",
    "    (\"encoder\", OneHotEncoder(handle_unknown=\"ignore\")),\n",
    "])\n",
    "\n",
    "preprocessor = ColumnTransformer([\n",
    "    (\"numeric\", numeric_pipeline, numeric_cols),\n",
    "    (\"categorical\", categorical_pipeline, categorical_cols),\n",
    "])\n",
    "\n",
    "linear_model = Pipeline([\n",
    "    (\"preprocessor\", preprocessor),\n",
    "    (\"model\", LinearRegression()),\n",
    "])\n",
    "\n",
    "linear_model.fit(X_train, y_train)\n",
    "\n",
    "train_predictions = linear_model.predict(X_train)\n",
    "val_predictions = linear_model.predict(X_val)\n",
    "\n",
    "results = []\n",
    "for split, actual, predicted in [\n",
    "    (\"Training\", y_train, train_predictions),\n",
    "    (\"Validation\", y_val, val_predictions),\n",
    "]:\n",
    "    results.append({\n",
    "        \"Dataset\": split,\n",
    "        \"MAE (£)\": mean_absolute_error(actual, predicted),\n",
    "        \"RMSE (£)\": np.sqrt(mean_squared_error(actual, predicted)),\n",
    "        \"R²\": r2_score(actual, predicted),\n",
    "    })\n",
    "\n",
    "print(f\"Training listings: {len(X_train):,}\")\n",
    "print(f\"Validation listings: {len(X_val):,}\")\n",
    "display(pd.DataFrame(results).round(3))\n",
    "\n",
    "comparison = pd.DataFrame({\n",
    "    \"Actual Price\": y_val.to_numpy(),\n",
    "    \"Predicted Price\": val_predictions,\n",
    "}, index=y_val.index)\n",
    "comparison[\"Absolute Error\"] = (\n",
    "    comparison[\"Actual Price\"] - comparison[\"Predicted Price\"]\n",
    ").abs()\n",
    "\n",
    "display(comparison.head(10).round(2))\n",
    "print(\"Negative validation predictions:\", (val_predictions < 0).sum())"
   ]
