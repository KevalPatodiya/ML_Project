    "from pathlib import Path\n",
    "\n",
    "import joblib\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from IPython.display import display\n",
    "\n",
    "PROJECT_DIR = Path(r\"D:\\Msc DS\\Machine Learning\\Project\\Sample Project\")\n",
    "TEST_PATH = PROJECT_DIR / \"test.csv\"\n",
    "MODEL_PATH = PROJECT_DIR / \"used_car_ridge_gradient_boosting.joblib\"\n",
    "# If you saved the model elsewhere, use the absolute path from the save cell.\n",
    "\n",
    "bundle = joblib.load(MODEL_PATH)\n",
    "test_raw = pd.read_csv(TEST_PATH)\n",
    "\n",
    "# Apply the same listing filters as training.\n",
    "eligible = (\n",
    "    test_raw[\"condition\"].eq(\"Used\")\n",
    "    & test_raw[\"reg_year\"].notna()\n",
    "    & (test_raw[\"previous_owners\"].isna() | test_raw[\"previous_owners\"].lt(8))\n",
    ")\n",
    "\n",
    "# Within-10% scoring requires a positive actual asking price.\n",
    "test = test_raw.loc[eligible & test_raw[\"price_gbp\"].gt(0)].copy()\n",
    "if test.empty:\n",
    "    raise ValueError(\"No eligible test listings have a positive asking price.\")\n",
    "\n",
    "# Recreate the model inputs from the raw columns.\n",
    "co2 = (test[\"co2_gkm\"] * 1.609344).round()\n",
    "test[\"co2_gmile\"] = co2.mask(co2.isin([1608, 2092]))\n",
    "test[\"power_hp\"] = test[\"power_hp\"].mask(test[\"power_hp\"].le(0))\n",
    "\n",
    "for column in [\"doors\", \"seats\"]:\n",
    "    test[column] = test[column].mask(test[column].lt(2))\n",
    "\n",
    "categorical_columns = [\n",
    "    \"make\", \"model\", \"version\", \"fuel\", \"transmission\", \"body_type\",\n",
    "    \"body_color\", \"drivetrain\", \"emission_class\", \"seller_type\",\n",
    "    \"seller_city\", \"seller_county\",\n",
    "]\n",
    "\n",
    "for column in categorical_columns:\n",
    "    test[column] = (\n",
    "        test[column].str.strip()\n",
    "        .replace({\"\": \"Unknown\", \"Unlisted\": \"Unknown\"})\n",
    "        .fillna(\"Unknown\")\n",
    "    )\n",
    "\n",
    "test[\"log_mileage\"] = np.log1p(test[\"mileage_miles\"])\n",
    "test[\"make_model\"] = test[\"make\"] + \" | \" + test[\"model\"]\n",
    "\n",
    "X_test = test.loc[:, bundle[\"feature_columns\"]]\n",
    "actual = test[\"price_gbp\"].to_numpy()\n",
    "\n",
    "ridge_prediction = bundle[\"base_model\"].predict(X_test)\n",
    "correction = bundle[\"correction_model\"].predict(X_test)\n",
    "ensemble_prediction = ridge_prediction + bundle[\"correction_weight\"] * correction\n",
    "\n",
    "tolerance = 0.10 * actual\n",
    "ridge_hits = np.abs(actual - ridge_prediction) <= tolerance\n",
    "ensemble_hits = np.abs(actual - ensemble_prediction) <= tolerance\n",
    "\n",
    "results = []\n",
    "for name, predicted, hits in [\n",
    "    (\"Log-price Ridge\", ridge_prediction, ridge_hits),\n",
    "    (\"Ridge + Gradient Boosting\", ensemble_prediction, ensemble_hits),\n",
    "]:\n",
    "    absolute_error = np.abs(actual - predicted)\n",
    "    results.append({\n",
    "        \"Model\": name,\n",
    "        \"Within 10% (%)\": 100 * hits.mean(),\n",
    "        \"Within 10% count\": int(hits.sum()),\n",
    "        \"Above 10% count\": int((~hits).sum()),\n",
    "        \"MAE (£)\": absolute_error.mean(),\n",
    "        \"MAPE (%)\": 100 * (absolute_error / actual).mean(),\n",
    "    })\n",
    "\n",
    "print(f\"Scored {len(test):,} of {len(test_raw):,} test listings.\")\n",
    "display(pd.DataFrame(results).set_index(\"Model\").round(3))\n",
    "\n",
    "gain = 100 * (ensemble_hits.mean() - ridge_hits.mean())\n",
    "print(f\"Change from the correction: {gain:+.3f} percentage points\")\n",
    "print(f\"Moved within 10%: {(ensemble_hits & ~ridge_hits).sum():,}\")\n",
    "print(f\"Moved outside 10%: {(ridge_hits & ~ensemble_hits).sum():,}\")"
   ]
  },
