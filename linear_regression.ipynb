   "source": [
    "from pathlib import Path\n",
    "\n",
    "import joblib\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from IPython.display import display\n",
    "\n",
    "from sklearn.base import clone\n",
    "from sklearn.ensemble import GradientBoostingRegressor\n",
    "from sklearn.metrics import (\n",
    "    mean_absolute_error,\n",
    "    mean_absolute_percentage_error,\n",
    "    mean_squared_error,\n",
    "    r2_score,\n",
    ")\n",
    "from sklearn.model_selection import GroupKFold, GroupShuffleSplit, train_test_split\n",
    "from sklearn.pipeline import Pipeline\n",
    "\n",
    "\n",
    "CSV_PATH = Path(\n",
    "    \"uk_used_cars_autotrader.csv\"\n",
    ")\n",
    "MODEL_PATH = Path(\n",
    "    \"used_car_log_price_ridge.joblib\"\n",
    ")\n",
    "SEED = 42\n",
    "\n",
    "for path in (CSV_PATH, MODEL_PATH):\n",
    "    if not path.is_file():\n",
    "        raise FileNotFoundError(f\"File not found: {path}\")\n",
    "\n",
    "# Preserve the column order used to construct the original grouping hashes.\n",
    "numeric_columns = [\n",
    "    \"mileage_miles\", \"reg_year\", \"power_hp\", \"doors\", \"seats\",\n",
    "    \"previous_owners\", \"annual_tax_gbp\", \"co2_gmile\",\n",
    "]\n",
    "categorical_columns = [\n",
    "    \"make\", \"model\", \"version\", \"fuel\", \"transmission\", \"body_type\",\n",
    "    \"body_color\", \"drivetrain\", \"emission_class\", \"seller_type\",\n",
    "    \"seller_city\", \"seller_county\",\n",
    "]\n",
    "\n",
    "\n",
    "def prepare_listings(data):\n",
    "    eligible = (\n",
    "        data[\"condition\"].eq(\"Used\")\n",
    "        & data[\"reg_year\"].notna()\n",
    "        & (data[\"previous_owners\"].isna() | data[\"previous_owners\"].lt(8))\n",
    "    )\n",
    "    data = data.loc[eligible].copy()\n",
    "\n",
    "    co2 = (data[\"co2_gkm\"] * 1.609344).round()\n",
    "    data[\"co2_gmile\"] = co2.mask(co2.isin([1608, 2092]))\n",
    "    data[\"power_hp\"] = data[\"power_hp\"].mask(data[\"power_hp\"].le(0))\n",
    "\n",
    "    for column in [\"doors\", \"seats\"]:\n",
    "        data[column] = data[column].mask(data[column].lt(2))\n",
    "\n",
    "    for column in categorical_columns:\n",
    "        data[column] = (\n",
    "            data[column].str.strip()\n",
    "            .replace({\"\": \"Unknown\", \"Unlisted\": \"Unknown\"})\n",
    "            .fillna(\"Unknown\")\n",
    "        )\n",
    "\n",
    "    return data[numeric_columns + categorical_columns], data[\"price_gbp\"]\n",
    "\n",
    "\n",
    "saved_ridge = joblib.load(MODEL_PATH)[\"model\"]\n",
    "raw_data = pd.read_csv(CSV_PATH)\n",
    "\n",
    "# Recreate the original split while reserving the original test rows.\n",
    "development, _ = train_test_split(raw_data, test_size=0.20, random_state=SEED)\n",
    "X_dev, y_dev = prepare_listings(development)\n",
    "\n",
    "groups = pd.util.hash_pandas_object(X_dev, index=False)\n",
    "splitter = GroupShuffleSplit(n_splits=1, test_size=0.20, random_state=SEED)\n",
    "train_idx, val_idx = next(splitter.split(X_dev, y_dev, groups=groups))\n",
    "\n",
    "X_dev = X_dev.assign(\n",
    "    log_mileage=np.log1p(X_dev[\"mileage_miles\"]),\n",
    "    make_model=X_dev[\"make\"] + \" | \" + X_dev[\"model\"],\n",
    ")\n",
    "X_dev = X_dev.loc[:, saved_ridge.feature_names_in_]\n",
    "\n",
    "X_train, X_val = X_dev.iloc[train_idx], X_dev.iloc[val_idx]\n",
    "y_train, y_val = y_dev.iloc[train_idx], y_dev.iloc[val_idx]\n",
    "train_groups = groups.iloc[train_idx]\n",
    "\n",
    "base_prediction = saved_ridge.predict(X_val)\n",
    "base_mae = mean_absolute_error(y_val, base_prediction)\n",
    "print(f\"Saved Ridge MAE on {len(X_val):,} validation listings: £{base_mae:,.2f}\")\n",
    "\n",
    "# Check the baseline before starting the five Ridge fits.\n",
    "if len(X_val) != 73_695 or not np.isclose(\n",
    "    base_mae, 1764.78, atol=0.05, rtol=0\n",
    "):\n",
    "    raise ValueError(\n",
    "        \"Expected 73,695 validation listings and approximately £1,764.78 MAE. \"\n",
    "        \"Check that the raw CSV and model match the original Ridge run.\"\n",
    "    )\n",
    "\n",
    "# Each training row gets a prediction from a Ridge fit that held out its group.\n",
    "oof_predictions = np.full(len(X_train), np.nan)\n",
    "cv = GroupKFold(n_splits=5)\n",
    "\n",
    "for fold, (fit_idx, score_idx) in enumerate(\n",
    "    cv.split(X_train, y_train, groups=train_groups), start=1\n",
    "):\n",
    "    print(f\"Fitting Ridge fold {fold}/5...\", flush=True)\n",
    "    fold_ridge = clone(saved_ridge)\n",
    "    fold_ridge.fit(X_train.iloc[fit_idx], y_train.iloc[fit_idx])\n",
    "    oof_predictions[score_idx] = fold_ridge.predict(X_train.iloc[score_idx])\n",
    "\n",
    "if not np.isfinite(oof_predictions).all():\n",
    "    raise ValueError(\"Some out-of-fold predictions are missing or invalid.\")\n",
    "\n",
    "training_residuals = y_train.to_numpy() - oof_predictions\n",
    "\n",
    "# Fit a separate model to predict the signed error directly in pounds.\n",
    "residual_model = Pipeline([\n",
    "    (\n",
    "        \"preprocessor\",\n",
    "        clone(saved_ridge.regressor_.named_steps[\"preprocessor\"]),\n",
    "    ),\n",
    "    (\n",
    "        \"model\",\n",
    "        GradientBoostingRegressor(\n",
    "            loss=\"huber\",\n",
    "            n_estimators=40,\n",
    "            learning_rate=0.05,\n",
    "            max_depth=3,\n",
    "            min_samples_leaf=30,\n",
    "            random_state=SEED,\n",
    "            verbose=1,\n",
    "        ),\n",
    "    ),\n",
    "])\n",
    "\n",
    "print(\"Fitting Gradient Boosting on Ridge residuals...\", flush=True)\n",
    "residual_model.fit(X_train, training_residuals)\n",
    "\n",
    "predicted_correction = residual_model.predict(X_val)\n",
    "corrected_prediction = base_prediction + predicted_correction\n",
    "\n",
    "actual = y_val.to_numpy()\n",
    "positive_price = actual > 0\n",
    "results = []\n",
    "\n",
    "for name, prediction in [\n",
    "    (\"Saved log-price Ridge\", base_prediction),\n",
    "    (\"Ridge + Gradient Boosting correction\", corrected_prediction),\n",
    "]:\n",
    "    residual = actual - prediction\n",
    "\n",
    "    results.append({\n",
    "        \"Model\": name,\n",
    "        \"MAE (£)\": mean_absolute_error(actual, prediction),\n",
    "        \"RMSE (£)\": np.sqrt(mean_squared_error(actual, prediction)),\n",
    "        \"MAPE (%)\": 100 * mean_absolute_percentage_error(\n",
    "            actual[positive_price], prediction[positive_price]\n",
    "        ),\n",
    "        \"R²\": r2_score(actual, prediction),\n",
    "        \"Within 10% (%)\": 100 * np.mean(\n",
    "            np.abs(residual[positive_price]) <= 0.10 * actual[positive_price]\n",
    "        ),\n",
    "        \"Mean residual (£)\": residual.mean(),\n",
    "    })\n",
    "\n",
    "comparison = pd.DataFrame(results).set_index(\"Model\")\n",
    "display(comparison.round(3))\n",
    "\n",
    "corrected_mae = mean_absolute_error(actual, corrected_prediction)\n",
    "print(f\"Validation MAE improvement: £{base_mae - corrected_mae:+,.2f}\")\n",
    "\n",
    "prediction_details = pd.DataFrame({\n",
    "    \"Actual (£)\": actual,\n",
    "    \"Ridge prediction (£)\": base_prediction,\n",
    "    \"Predicted correction (£)\": predicted_correction,\n",
    "    \"Corrected prediction (£)\": corrected_prediction,\n",
    "    \"Ridge residual (£)\": actual - base_prediction,\n",
    "    \"Corrected residual (£)\": actual - corrected_prediction,\n",
    "}, index=y_val.index)\n",
    "\n",
    "display(prediction_details.head(15).round(2))"
   ]
