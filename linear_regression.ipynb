    "from sklearn.linear_model import SGDRegressor\n",
    "from sklearn.pipeline import Pipeline\n",
    "from sklearn.model_selection import GridSearchCV\n",
    "from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score\n",
    "import numpy as np\n",
    "\n",
    "# Use the polynomial degree selected by your previous search\n",
    "sgd_model = Pipeline([\n",
    "    (\"preprocessor\", best_poly_model.named_steps[\"preprocessor\"]),\n",
    "    (\"model\", SGDRegressor(\n",
    "        loss=\"squared_error\",\n",
    "        penalty=\"l2\",\n",
    "        max_iter=3000,\n",
    "        tol=1e-4,\n",
    "        average=True,\n",
    "        random_state=42\n",
    "    ))\n",
    "])\n",
    "\n",
    "param_grid = {\n",
    "    \"model__alpha\": [0.0001, 0.001, 0.01],\n",
    "    \"model__learning_rate\": [\"adaptive\"],\n",
    "    \"model__eta0\": [0.0001, 0.001]\n",
    "}\n",
    "\n",
    "sgd_search = GridSearchCV(\n",
    "    sgd_model,\n",
    "    param_grid,\n",
    "    scoring=\"neg_mean_absolute_error\",\n",
    "    cv=cv,\n",
    "    n_jobs=2,\n",
    "    pre_dispatch=2,\n",
    "    verbose=1\n",
    ")\n",
    "\n",
    "sgd_search.fit(X_train, y_train)\n",
    "\n",
    "predictions = sgd_search.predict(X_val)\n",
    "\n",
    "print(\"Best parameters:\", sgd_search.best_params_)\n",
    "print(\"Validation MAE (£):\",\n",
    "      round(mean_absolute_error(y_val, predictions), 2))\n",
    "print(\"Validation RMSE (£):\",\n",
    "      round(np.sqrt(mean_squared_error(y_val, predictions)), 2))\n",
    "print(\"Validation R²:\", round(r2_score(y_val, predictions), 4))"
