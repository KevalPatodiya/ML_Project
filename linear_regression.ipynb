    "from pathlib import Path\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from IPython.display import display\n",
    "from scipy.sparse.linalg import LinearOperator, eigsh\n",
    "\n",
    "from sklearn.compose import ColumnTransformer\n",
    "from sklearn.ensemble import GradientBoostingRegressor\n",
    "from sklearn.impute import SimpleImputer\n",
    "from sklearn.metrics import r2_score\n",
    "from sklearn.model_selection import GroupKFold\n",
    "from sklearn.pipeline import make_pipeline\n",
    "from sklearn.preprocessing import OneHotEncoder, StandardScaler\n",
    "\n",
    "\n",
    "PROJECT_DIR = Path(r\"D:\\Msc DS\\Machine Learning\\Project\\Sample Project\")\n",
    "SEED = 42\n",
    "ALPHA = 0.00003\n",
    "\n",
    "excluded_columns = [\n",
    "    \"price_gbp\", \"log_price\", \"price_eur\", \"is_high_value\",\n",
    "    \"price_evaluation\", \"emission_class\",\n",
    "]\n",
    "\n",
    "\n",
    "def load_data(filename):\n",
    "    data = pd.read_csv(PROJECT_DIR / filename)\n",
    "    prices = data[\"price_gbp\"].to_numpy()\n",
    "\n",
    "    if not np.isfinite(prices).all() or (prices <= 0).any():\n",
    "        raise ValueError(f\"{filename} must contain finite, positive asking prices.\")\n",
    "\n",
    "    features = data.drop(columns=excluded_columns, errors=\"ignore\").copy()\n",
    "    features[\"log_mileage\"] = np.log1p(features[\"mileage_miles\"])\n",
    "    features[\"make_model\"] = (\n",
    "        features[\"make\"].fillna(\"Unknown\")\n",
    "        + \" | \"\n",
    "        + features[\"model\"].fillna(\"Unknown\")\n",
    "    )\n",
    "    return features, prices\n",
    "\n",
    "\n",
    "X_train, y_train = load_data(\"train_clean.csv\")\n",
    "X_test, y_test = load_data(\"test_clean.csv\")\n",
    "\n",
    "if not X_train.columns.equals(X_test.columns):\n",
    "    raise ValueError(\"Train and test must have matching feature columns.\")\n",
    "\n",
    "numeric_cols = X_train.select_dtypes(include=[\"number\", \"bool\"]).columns.tolist()\n",
    "categorical_cols = X_train.columns.difference(numeric_cols, sort=False).tolist()\n",
    "\n",
    "\n",
    "def make_preprocessor():\n",
    "    return ColumnTransformer([\n",
    "        (\"numeric\", SimpleImputer(strategy=\"median\"), numeric_cols),\n",
    "        (\"categorical\", make_pipeline(\n",
    "            SimpleImputer(strategy=\"constant\", fill_value=\"Unknown\"),\n",
    "            OneHotEncoder(handle_unknown=\"ignore\"),\n",
    "        ), categorical_cols),\n",
    "    ], sparse_threshold=1.0)\n",
    "\n",
    "\n",
    "def fit_log_lasso(features, prices):\n",
    "    preprocessor = make_pipeline(\n",
    "        make_preprocessor(),\n",
    "        StandardScaler(with_mean=False),\n",
    "    )\n",
    "    matrix = preprocessor.fit_transform(features).tocsr()\n",
    "    transpose = matrix.T\n",
    "    n_rows, n_features = matrix.shape\n",
    "\n",
    "    target = np.log1p(prices)\n",
    "    target_mean = target.mean()\n",
    "    target = target - target_mean\n",
    "    feature_means = np.asarray(matrix.mean(axis=0)).ravel()\n",
    "\n",
    "    # Compute the step size using centred sparse matrix products.\n",
    "    def gram_product(weights):\n",
    "        values = matrix @ weights\n",
    "        return transpose @ (values - values.mean()) / n_rows\n",
    "\n",
    "    gram = LinearOperator(\n",
    "        (n_features, n_features), matvec=gram_product, dtype=np.float64\n",
    "    )\n",
    "    initial_vector = np.random.default_rng(SEED).standard_normal(n_features)\n",
    "    lipschitz = 1.04 * eigsh(\n",
    "        gram, k=1, which=\"LA\", tol=0.005,\n",
    "        v0=initial_vector, return_eigenvectors=False,\n",
    "    )[0]\n",
    "\n",
    "    # Accelerated proximal gradient for the Lasso objective.\n",
    "    weights = np.zeros(n_features)\n",
    "    extrapolated = weights.copy()\n",
    "    momentum = 1.0\n",
    "    tolerance = 1e-4 * np.dot(target, target) / n_rows\n",
    "\n",
    "    for step in range(1, 4_001):\n",
    "        residual = matrix @ extrapolated - target\n",
    "        gradient = transpose @ (residual - residual.mean()) / n_rows\n",
    "        update = extrapolated - gradient / lipschitz\n",
    "        next_weights = np.sign(update) * np.maximum(\n",
    "            np.abs(update) - ALPHA / lipschitz, 0.0\n",
    "        )\n",
    "\n",
    "        next_momentum = (1 + np.sqrt(1 + 4 * momentum**2)) / 2\n",
    "        extrapolated = next_weights + (\n",
    "            (momentum - 1) / next_momentum\n",
    "        ) * (next_weights - weights)\n",
    "        weights, momentum = next_weights, next_momentum\n",
    "\n",
    "        if step % 25 == 0:\n",
    "            residual = target - matrix @ weights\n",
    "            residual -= residual.mean()\n",
    "            max_correlation = np.max(np.abs(transpose @ residual)) / n_rows\n",
    "            dual = residual * min(1.0, ALPHA / max(max_correlation, 1e-30))\n",
    "            gap = (\n",
    "                0.5 * np.dot(residual, residual)\n",
    "                - np.dot(target, dual)\n",
    "                + 0.5 * np.dot(dual, dual)\n",
    "            ) / n_rows + ALPHA * np.abs(weights).sum()\n",
    "\n",
    "            if 0 <= gap <= tolerance:\n",
    "                print(f\"  Lasso converged at iteration {step}.\", flush=True)\n",
    "                intercept = target_mean - feature_means @ weights\n",
    "                return preprocessor, weights, intercept\n",
    "\n",
    "    raise RuntimeError(f\"Lasso did not converge. Final duality gap: {gap:.3g}\")\n",
    "\n",
    "\n",
    "def predict_lasso(fitted_lasso, features):\n",
    "    preprocessor, weights, intercept = fitted_lasso\n",
    "    log_price = preprocessor.transform(features) @ weights + intercept\n",
    "    return np.expm1(log_price)\n",
    "\n",
    "\n",
    "# Build residual targets from predictions on held-out training folds.\n",
    "groups = pd.util.hash_pandas_object(X_train, index=False)\n",
    "cv = GroupKFold(n_splits=5)\n",
    "oof_predictions = np.full(len(y_train), np.nan)\n",
    "\n",
    "print(f\"Training listings: {len(X_train):,} | Test listings: {len(X_test):,}\")\n",
    "\n",
    "for fold, (fit_idx, held_out_idx) in enumerate(\n",
    "    cv.split(X_train, y_train, groups=groups), start=1\n",
    "):\n",
    "    print(f\"Fitting Lasso fold {fold}/5...\", flush=True)\n",
    "    fold_lasso = fit_log_lasso(X_train.iloc[fit_idx], y_train[fit_idx])\n",
    "    oof_predictions[held_out_idx] = predict_lasso(\n",
    "        fold_lasso, X_train.iloc[held_out_idx]\n",
    "    )\n",
    "\n",
    "if not np.isfinite(oof_predictions).all():\n",
    "    raise ValueError(\"Some out-of-fold predictions are missing or non-finite.\")\n",
    "\n",
    "print(\"Fitting Lasso on all training rows...\", flush=True)\n",
    "tuned_lasso = fit_log_lasso(X_train, y_train)\n",
    "\n",
    "print(\"Fitting Gradient Boosting on Lasso residuals...\", flush=True)\n",
    "residual_model = make_pipeline(\n",
    "    make_preprocessor(),\n",
    "    GradientBoostingRegressor(\n",
    "        loss=\"huber\",\n",
    "        n_estimators=40,\n",
    "        learning_rate=0.05,\n",
    "        max_depth=3,\n",
    "        min_samples_leaf=30,\n",
    "        random_state=SEED,\n",
    "        verbose=1,\n",
    "    ),\n",
    ")\n",
    "residual_model.fit(X_train, y_train - oof_predictions)\n",
    "\n",
    "lasso_prediction = predict_lasso(tuned_lasso, X_test)\n",
    "predicted_correction = residual_model.predict(X_test)\n",
    "ensemble_prediction = lasso_prediction + predicted_correction\n",
    "\n",
    "rows = []\n",
    "for name, predicted in [\n",
    "    (\"Tuned log-price Lasso\", lasso_prediction),\n",
    "    (\"Tuned Lasso + Gradient Boosting\", ensemble_prediction),\n",
    "]:\n",
    "    error = np.abs(y_test - predicted)\n",
    "    hits = error <= 0.10 * y_test\n",
    "\n",
    "    rows.append({\n",
    "        \"Model\": name,\n",
    "        \"MAE (£)\": error.mean(),\n",
    "        \"RMSE (£)\": np.sqrt(np.mean(error**2)),\n",
    "        \"MAPE (%)\": 100 * np.mean(error / y_test),\n",
    "        \"R²\": r2_score(y_test, predicted),\n",
    "        \"Within 10% (%)\": 100 * hits.mean(),\n",
    "        \"Listings within 10%\": int(hits.sum()),\n",
    "    })\n",
    "\n",
    "comparison = pd.DataFrame(rows).set_index(\"Model\")\n",
    "display(comparison.round(3))\n",
    "\n",
    "mae_gain = rows[0][\"MAE (£)\"] - rows[1][\"MAE (£)\"]\n",
    "hit_rate_gain = rows[1][\"Within 10% (%)\"] - rows[0][\"Within 10% (%)\"]\n",
    "print(f\"MAE improvement: £{mae_gain:+,.2f}\")\n",
    "print(f\"Within-10% improvement: {hit_rate_gain:+.3f} percentage points\")"
   ]
