    "from pathlib import Path\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from IPython.display import display\n",
    "\n",
    "from sklearn.base import clone\n",
    "from sklearn.compose import ColumnTransformer, TransformedTargetRegressor\n",
    "from sklearn.ensemble import GradientBoostingRegressor\n",
    "from sklearn.impute import SimpleImputer\n",
    "from sklearn.linear_model import Ridge\n",
    "from sklearn.metrics import r2_score\n",
    "from sklearn.model_selection import GroupKFold\n",
    "from sklearn.pipeline import Pipeline\n",
    "from sklearn.preprocessing import OneHotEncoder, StandardScaler\n",
    "\n",
    "\n",
    "PROJECT_DIR = Path(r\"D:\\Msc DS\\Machine Learning\\Project\\Sample Project\")\n",
    "SEED = 42\n",
    "\n",
    "train = pd.read_csv(PROJECT_DIR / \"train_clean.csv\")\n",
    "test = pd.read_csv(PROJECT_DIR / \"test_clean.csv\")\n",
    "\n",
    "if not train.columns.equals(test.columns):\n",
    "    raise ValueError(\"The cleaned train and test CSVs must have matching columns.\")\n",
    "\n",
    "y_train = train[\"price_gbp\"].to_numpy()\n",
    "y_test = test[\"price_gbp\"].to_numpy()\n",
    "\n",
    "for split, prices in [(\"Training\", y_train), (\"Test\", y_test)]:\n",
    "    if not np.isfinite(prices).all() or (prices <= 0).any():\n",
    "        raise ValueError(f\"{split} asking prices must be finite and positive.\")\n",
    "\n",
    "# Exclude the target and price-derived fields. Omit emission_class to\n",
    "# reproduce the selected Ridge configuration.\n",
    "excluded_columns = [\n",
    "    \"price_gbp\", \"log_price\", \"price_eur\",\n",
    "    \"is_high_value\", \"price_evaluation\", \"emission_class\",\n",
    "]\n",
    "\n",
    "\n",
    "def make_features(data):\n",
    "    features = data.drop(columns=excluded_columns, errors=\"ignore\").copy()\n",
    "    features[\"log_mileage\"] = np.log1p(features[\"mileage_miles\"])\n",
    "    features[\"make_model\"] = (\n",
    "        features[\"make\"].fillna(\"Unknown\")\n",
    "        + \" | \"\n",
    "        + features[\"model\"].fillna(\"Unknown\")\n",
    "    )\n",
    "    return features\n",
    "\n",
    "\n",
    "X_train = make_features(train)\n",
    "X_test = make_features(test)\n",
    "\n",
    "numeric_cols = X_train.select_dtypes(include=[\"number\", \"bool\"]).columns.tolist()\n",
    "categorical_cols = X_train.columns.difference(numeric_cols, sort=False).tolist()\n",
    "\n",
    "preprocessor = ColumnTransformer(\n",
    "    [\n",
    "        (\"numeric\", SimpleImputer(strategy=\"median\"), numeric_cols),\n",
    "        (\"categorical\", Pipeline([\n",
    "            (\"imputer\", SimpleImputer(strategy=\"constant\", fill_value=\"Unknown\")),\n",
    "            (\"encoder\", OneHotEncoder(handle_unknown=\"ignore\")),\n",
    "        ]), categorical_cols),\n",
    "    ],\n",
    "    sparse_threshold=1.0,\n",
    ")\n",
    "\n",
    "ridge = TransformedTargetRegressor(\n",
    "    regressor=Pipeline([\n",
    "        (\"preprocessor\", clone(preprocessor)),\n",
    "        (\"scale\", StandardScaler(with_mean=False)),\n",
    "        (\"model\", Ridge(alpha=0.1, solver=\"lsqr\")),\n",
    "    ]),\n",
    "    func=np.log1p,\n",
    "    inverse_func=np.expm1,\n",
    ")\n",
    "\n",
    "# Keep identical predictor rows in the same training fold.\n",
    "groups = pd.util.hash_pandas_object(X_train, index=False)\n",
    "cv = GroupKFold(n_splits=5)\n",
    "oof_prediction = np.full(len(y_train), np.nan)\n",
    "\n",
    "print(f\"Training listings: {len(X_train):,}\")\n",
    "print(f\"Test listings: {len(X_test):,}\")\n",
    "\n",
    "for fold, (fit_idx, held_out_idx) in enumerate(\n",
    "    cv.split(X_train, y_train, groups=groups), start=1\n",
    "):\n",
    "    print(f\"Fitting Ridge fold {fold}/5...\", flush=True)\n",
    "    fold_ridge = clone(ridge)\n",
    "    fold_ridge.fit(X_train.iloc[fit_idx], y_train[fit_idx])\n",
    "    oof_prediction[held_out_idx] = fold_ridge.predict(X_train.iloc[held_out_idx])\n",
    "\n",
    "if not np.isfinite(oof_prediction).all():\n",
    "    raise ValueError(\"Some out-of-fold predictions are missing or non-finite.\")\n",
    "\n",
    "training_residuals = y_train - oof_prediction\n",
    "\n",
    "print(\"Fitting Ridge on all training rows...\", flush=True)\n",
    "ridge.fit(X_train, y_train)\n",
    "\n",
    "residual_model = Pipeline([\n",
    "    (\"preprocessor\", clone(preprocessor)),\n",
    "    (\"model\", GradientBoostingRegressor(\n",
    "        loss=\"huber\",\n",
    "        n_estimators=40,\n",
    "        learning_rate=0.05,\n",
    "        max_depth=3,\n",
    "        min_samples_leaf=30,\n",
    "        random_state=SEED,\n",
    "        verbose=1,\n",
    "    )),\n",
    "])\n",
    "\n",
    "print(\"Fitting Gradient Boosting on Ridge residuals...\", flush=True)\n",
    "residual_model.fit(X_train, training_residuals)\n",
    "\n",
    "ridge_prediction = ridge.predict(X_test)\n",
    "predicted_correction = residual_model.predict(X_test)\n",
    "ensemble_prediction = ridge_prediction + predicted_correction\n",
    "\n",
    "rows = []\n",
    "for name, predicted in [\n",
    "    (\"New log-price Ridge\", ridge_prediction),\n",
    "    (\"New Ridge + Gradient Boosting\", ensemble_prediction),\n",
    "]:\n",
    "    residual = y_test - predicted\n",
    "    absolute_error = np.abs(residual)\n",
    "    within_10 = absolute_error <= 0.10 * y_test\n",
    "\n",
    "    rows.append({\n",
    "        \"Model\": name,\n",
    "        \"MAE (£)\": absolute_error.mean(),\n",
    "        \"RMSE (£)\": np.sqrt(np.mean(residual ** 2)),\n",
    "        \"Median absolute error (£)\": np.median(absolute_error),\n",
    "        \"MAPE (%)\": 100 * np.mean(absolute_error / y_test),\n",
    "        \"R²\": r2_score(y_test, predicted),\n",
    "        \"Within 10% (%)\": 100 * within_10.mean(),\n",
    "        \"Listings within 10%\": int(within_10.sum()),\n",
    "    })\n",
    "\n",
    "comparison = pd.DataFrame(rows).set_index(\"Model\")\n",
    "display(comparison.round(3))\n",
    "\n",
    "mae_gain = rows[0][\"MAE (£)\"] - rows[1][\"MAE (£)\"]\n",
    "within_10_gain = rows[1][\"Within 10% (%)\"] - rows[0][\"Within 10% (%)\"]\n",
    "\n",
    "print(f\"MAE improvement: £{mae_gain:+,.2f}\")\n",
    "print(f\"Within-10% improvement: {within_10_gain:+.3f} percentage points\")"
   ]
