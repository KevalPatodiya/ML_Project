    "import numpy as np\n",
    "import pandas as pd\n",
    "from IPython.display import display\n",
    "from sklearn.base import clone\n",
    "\n",
    "# Use out-of-fold Ridge predictions to build the training target.\n",
    "train_actual = y_train.to_numpy()\n",
    "train_ridge = np.maximum(np.asarray(oof_predictions), 0.0)\n",
    "\n",
    "log_residuals = np.log1p(train_actual) - np.log1p(train_ridge)\n",
    "\n",
    "relative_booster = clone(residual_model)\n",
    "relative_booster.fit(X_train, log_residuals)\n",
    "\n",
    "# Apply the correction on the log scale, then convert back to pounds.\n",
    "val_ridge = np.maximum(np.asarray(base_prediction), 0.0)\n",
    "log_correction = relative_booster.predict(X_val)\n",
    "relative_prediction = np.expm1(np.log1p(val_ridge) + log_correction)\n",
    "\n",
    "actual = y_val.to_numpy()\n",
    "positive = actual > 0\n",
    "rows = []\n",
    "\n",
    "for name, predicted in [\n",
    "    (\"Saved log-price Ridge\", base_prediction),\n",
    "    (\"Ridge + correction in pounds\", corrected_prediction),\n",
    "    (\"Ridge + proportional correction\", relative_prediction),\n",
    "]:\n",
    "    absolute_error = np.abs(actual - predicted)\n",
    "    hits = absolute_error[positive] <= 0.10 * actual[positive]\n",
    "\n",
    "    rows.append({\n",
    "        \"Model\": name,\n",
    "        \"Within 10% (%)\": 100 * hits.mean(),\n",
    "        \"Listings within 10%\": int(hits.sum()),\n",
    "        \"MAE (£)\": absolute_error.mean(),\n",
    "        \"MAPE (%)\": 100 * (absolute_error[positive] / actual[positive]).mean(),\n",
    "        \"RMSE (£)\": np.sqrt(np.mean(absolute_error ** 2)),\n",
    "    })\n",
    "\n",
    "comparison = pd.DataFrame(rows).set_index(\"Model\")\n",
    "display(comparison.round(3))\n",
    "\n",
    "gain = (\n",
    "    comparison.loc[\"Ridge + proportional correction\", \"Within 10% (%)\"]\n",
    "    - comparison.loc[\"Ridge + correction in pounds\", \"Within 10% (%)\"]\n",
    ")\n",
    "print(f\"Change vs current correction: {gain:+.3f} percentage points\")"
   ]
  },
